+import 'reflect-metadata';
+import * as assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { plainToInstance } from 'class-transformer';
+import { validate } from 'class-validator';
+import { GUARDS_METADATA } from '@nestjs/common/constants';
+import { IS_PUBLIC_KEY } from '../auth/decorators/public.decorator';
+import { ConnectorController, ConnectorRegistrationController, BiometricAdminController } from './biometric.controller';
+import { ConnectorGuard } from './connector.guard';
+import { BatchDto, PairDto, DeviceDto } from './biometric.dto';
+import { biometricSchemas } from './biometric.schemas';
+import { eventIdentity } from './biometric.service';
+
+test('connector routes bypass human JWT only behind the connector guard', () => {
+  assert.equal(Reflect.getMetadata(IS_PUBLIC_KEY, ConnectorController), true);
+  assert.deepEqual(Reflect.getMetadata(GUARDS_METADATA, ConnectorController), [ConnectorGuard]);
+  assert.equal(Reflect.getMetadata(IS_PUBLIC_KEY, BiometricAdminController), undefined);
+  assert.equal(Reflect.getMetadata(IS_PUBLIC_KEY, ConnectorRegistrationController.prototype.pair), true);
+});
+
+test('strict nested batches reject extra ownership fields and biometric templates', async () => {
+  const dto = plainToInstance(BatchDto, { deviceId: 'a'.repeat(24), generation: 'g', position: '1', dataGap: false,
+    gymId: 'b'.repeat(24), events: [{ eventId: 'c'.repeat(64), nativeId: '1', deviceUserId: '1001',
+      occurredAt: new Date().toISOString(), rawTimestamp: 'raw', timezone: 'Asia/Kolkata', eventType: 'check-in', fingerprint: 'no' }] });
+  const errors = await validate(dto, { whitelist: true, forbidNonWhitelisted: true });
+  assert.ok(errors.some(e => e.property === 'gymId'));
+  assert.ok(errors.some(e => e.property === 'events' && e.children?.length));
+  assert.ok((await validate(plainToInstance(PairDto, { code: '123', appVersion: '0.1.0' }))).length);
+  assert.ok((await validate(plainToInstance(DeviceDto, { connectorId: 'a'.repeat(24), adapter: 'unverified-hardware',
+    ip: '192.168.1.2', port: 4370, timezone: 'UTC', historySince: new Date().toISOString() }))).length);
+});
+
+test('event identity partitions native IDs by device and generation', () => {
+  assert.equal(eventIdentity('d', 'g', '1'), 'ef2ca68513652569a386f0577b48b670f93c93dfbcf1116a52259ecd4f95aa52');
+  assert.notEqual(eventIdentity('d', 'g', '1'), eventIdentity('d', 'g2', '1'));
+  assert.notEqual(eventIdentity('d', 'g', '1'), eventIdentity('other', 'g', '1'));
+  assert.match(eventIdentity('d', 'g', '1'), /^[a-f0-9]{64}$/);
+});
+
+test('critical ingestion and mapping indexes are unique', () => {
+  for (const name of ['BiometricEvent', 'BiometricMapping', 'BiometricAccess', 'BiometricCheckpoint'])
+    assert.ok(biometricSchemas[name].indexes().some(([, options]) => options.unique), name);
+});
