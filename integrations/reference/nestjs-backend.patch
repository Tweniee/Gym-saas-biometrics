+/** Isolated replica-set + real HTTP + Python connector. Never reads configured DBs. */
+import 'reflect-metadata';
+import * as assert from 'node:assert/strict';
+import { after, before, test } from 'node:test';
+import { Module, ValidationPipe } from '@nestjs/common';
+import { NestFactory } from '@nestjs/core';
+import { ConfigService } from '@nestjs/config';
+import { MongooseModule, getConnectionToken } from '@nestjs/mongoose';
+import { Connection, Types } from 'mongoose';
+import { MongoMemoryReplSet } from 'mongodb-memory-server';
+import { execFile } from 'node:child_process';
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { resolve, join } from 'node:path';
+import { biometricSchemas } from './biometric.schemas';
+import { BiometricService, digest } from './biometric.service';
+import { ConnectorGuard } from './connector.guard';
+import { ConnectorController, ConnectorRegistrationController } from './biometric.controller';
+import { AttendanceService } from '../attendance/attendance.service';
+import { AnalyticsService } from '../analytics/analytics.service';
+import { AttendanceSchema } from '../attendance/schemas/attendance.schema';
+
+let replica: MongoMemoryReplSet, app: any, connection: Connection, service: BiometricService, base: string, temporary: string;
+const id = () => new Types.ObjectId();
+const tenantA = id(), tenantB = id(), gymA = id(), gymB = id(), actor = id();
+const source = resolve(__dirname, '../../..', 'Gym-saas-biometrics/src');
+const collection = (name: string): any => connection.db.collection(name);
+
+before(async () => {
+  replica = await MongoMemoryReplSet.create({ replSet: { count: 1 } });
+  @Module({
+    imports: [MongooseModule.forRoot(replica.getUri('biometric_integration')),
+      MongooseModule.forFeature([...Object.entries(biometricSchemas).map(([name, schema]) => ({ name, schema })), { name: 'Attendance', schema: AttendanceSchema }])],
+    controllers: [ConnectorController, ConnectorRegistrationController],
+    providers: [BiometricService, ConnectorGuard, { provide: ConfigService, useValue: new ConfigService({ auth: { jwtSecret: 'isolated-biometric-test-secret-32-characters-only' } }) }],
+  }) class IntegrationModule {}
+  app = await NestFactory.create(IntegrationModule, { logger: false });
+  app.setGlobalPrefix('api/v1');
+  app.useGlobalPipes(new ValidationPipe({ whitelist: true, forbidNonWhitelisted: true, transform: true }));
+  await app.listen(0, '127.0.0.1');
+  base = await app.getUrl() + '/api/v1';
+  service = app.get(BiometricService);
+  connection = app.get(getConnectionToken());
+  await Promise.all(Object.values(connection.models).map(model => model.createIndexes()));
+  await collection('tenants').insertMany([{ _id: tenantA, isActive: true }, { _id: tenantB, isActive: true }]);
+  await collection('gyms').insertMany([{ _id: gymA, tenantId: tenantA, isActive: true }, { _id: gymB, tenantId: tenantB, isActive: true }]);
+  temporary = await mkdtemp(join(tmpdir(), 'zenvore-integration-'));
+});
+after(async () => { if (app) await app.close(); if (replica) await replica.stop(); if (temporary) await rm(temporary, { recursive: true, force: true }); });
+
+async function http(method: string, route: string, body?: any, token?: string) {
+  const response = await fetch(base + route, { method, headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: 'Bearer ' + token } : {}) },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
+  return { status: response.status, body: await response.json() };
+}
+const gym = () => ({ _id: gymA, tenantId: tenantA });
+async function installation() {
+  const code = await service.issuePairing(gym(), String(actor));
+  const pair = await service.pair({ code: code.code, appVersion: '0.1.0' });
+  const connector = await service.active(pair.connectorId);
+  const token = await service.token(pair);
+  return { pair, connector, token: token.accessToken };
+}
+const pythonScript = 
+'import json,sys\n' +
+'from pathlib import Path\n' +
+'from zenvore_connector.config import Config\n' +
+'from zenvore_connector.main import build\n' +
+'from zenvore_connector.cloud import CloudError\n' +
+'r=build(Config.load(Path(sys.argv[1])))\n' +
+'mode=sys.argv[2]\n' +
+'if mode=="pair": r.cloud.pair(sys.stdin.read().strip())\n' +
+'if mode=="lost-ack":\n' +
+' original=r.cloud.request\n' +
+' def lose(method,route,body=None,timeout=None):\n' +
+'  result=original(method,route,body,timeout)\n' +
+'  if route=="/connectors/me/attendance/batches": raise CloudError("CLOUD_NETWORK")\n' +
+'  return result\n' +
+' r.cloud.request=lose\n' +
+'if mode in ("sync","lost-ack"): r.heartbeat_once(); r.scheduled_once(); r.heartbeat_once()\n' +
+'if mode=="command":\n' +
+' for command in r.cloud.request("GET","/connectors/me/commands"): r.handle_command(command)\n' +
+'print(json.dumps({"pending":r.store.pending_count(),"checkpoint":r.store.checkpoint(sys.argv[3]) if len(sys.argv)>3 else None}))\n' +
+'r.store.close()\n';
+async function python(config: string, mode: string, device = '', input = '') {
+  return new Promise<any>((resolvePromise, reject) => {
+    const child = execFile(process.env.PYTHON || 'python3', ['-c', pythonScript, config, mode, device],
+      { env: { ...process.env, PYTHONPATH: source }, timeout: 30000 }, (error, stdout, stderr) => {
+        if (error) reject(new Error('Python integration failed: ' + stderr));
+        else { try { resolvePromise(JSON.parse(stdout)); } catch (e) { reject(e); } }
+      });
+    child.stdin.end(input);
+  });
+}
+
+test('pairing is atomic, single-use and expiring; stored credentials are verifiers', async () => {
+  const code = await service.issuePairing(gym(), String(actor));
+  const results = await Promise.allSettled([1, 2].map(() => service.pair({ code: code.code, appVersion: 'test' })));
+  assert.equal(results.filter(r => r.status === 'fulfilled').length, 1);
+  const stored = await collection('biometricpairings').findOne({ verifier: digest(code.code) });
+  assert.equal(stored.code, undefined);
+  const expired = await service.issuePairing(gym(), String(actor));
+  await collection('biometricpairings').updateOne({ verifier: digest(expired.code) }, { $set: { expiresAt: new Date(0) } });
+  await assert.rejects(service.pair({ code: expired.code, appVersion: 'test' }));
+  const installed = await installation();
+  assert.notEqual(installed.connector.credentialVerifier, installed.pair.credential);
+  await assert.rejects(service.token({ ...installed.pair, credential: 'f'.repeat(64) }));
+});
+
+test('scopes reject cross-gym reads, device assignments and member references', async () => {
+  const installed = await installation();
+  await assert.rejects(service.gym({ userId: String(actor), role: 'gym_owner', tenantId: String(tenantA) }, String(gymB)));
+  await assert.rejects(service.gym({ userId: String(actor), role: 'gym_staff', tenantId: String(tenantA), gymId: String(gymB) }, String(gymA)));
+  await assert.rejects(service.gym({ userId: String(actor), role: 'member', tenantId: String(tenantA), gymId: String(gymA) }, String(gymA)));
+  await assert.rejects(service.addDevice({ _id: gymB, tenantId: tenantB }, String(actor), { connectorId: installed.pair.connectorId,
+    adapter: 'simulator', ip: '127.0.0.1', port: 4370, timezone: 'Asia/Kolkata', historySince: new Date(Date.now() - 86400000).toISOString() }));
+});
+
+test('real Python connector survives lost acknowledgement and restart; unknown users resolve explicitly', async () => {
+  const configPath = join(temporary, 'config.json'), fixture = join(temporary, 'simulator.json');
+  await writeFile(configPath, JSON.stringify({ api_url: base, state_dir: temporary, development: true, simulator_file: fixture }));
+  const now = new Date().toISOString();
+  await writeFile(fixture, JSON.stringify({ devices: { '4370': { identity: 'SIM-INTEGRATION', generation: 'gen-1', users: ['1001'],
+    events: [{ index: 1, deviceUserId: '1001', timestamp: now, eventType: 'check-in' }] } } }));
+  const pairing = await service.issuePairing(gym(), String(actor));
+  await python(configPath, 'pair', '', pairing.code);
+  const connectors = await collection('biometricconnectors').find({ gymId: gymA }).sort({ createdAt: -1 }).toArray();
+  const connector = connectors[0];
+  const assigned = await service.addDevice(gym(), String(actor), { connectorId: String(connector._id), adapter: 'simulator', ip: '127.0.0.1', port: 4370,
+    timezone: 'Asia/Kolkata', historySince: new Date(Date.now() - 86400000).toISOString() });
+  const deviceId = assigned.deviceId;
+  const lost = await python(configPath, 'lost-ack', deviceId);
+  assert.equal(lost.pending, 1);
+  assert.equal(lost.checkpoint, null);
+  assert.equal(await collection('biometricevents').countDocuments({ deviceId: new Types.ObjectId(deviceId) }), 1);
+  assert.equal(await collection('attendances').countDocuments(), 0);
+  const recovered = await python(configPath, 'sync', deviceId);
+  assert.equal(recovered.pending, 0);
+  assert.equal(recovered.checkpoint.position, '1');
+  assert.equal(await collection('biometricevents').countDocuments({ deviceId: new Types.ObjectId(deviceId) }), 1);
+  const status = await service.status(gym());
+  assert.ok(status.connectors.find(c => String(c._id) === String(connector._id)).online);
+  assert.equal(status.unresolved.length, 1);
+  const memberId = id(), mappingId = id(), userId = id();
+  await collection('members').insertOne({ _id: memberId, userId, userGymMappingId: mappingId, isActive: true });
+  await collection('usergymmappings').insertOne({ _id: mappingId, userId, tenantId: tenantA, gymId: gymA, isActive: true });
+  await service.map(gym(), String(actor), deviceId, { deviceUserId: '1001', memberId: String(memberId) });
