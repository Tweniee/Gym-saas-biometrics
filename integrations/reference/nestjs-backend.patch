+  async observed(connector: any, deviceId: string, dto: any) {
+    await this.device(connector, deviceId);
+    const state = await this.c('access').findOne({ deviceId: oid(deviceId), memberId: oid(dto.memberId),
+      gymId: connector.gymId, tenantId: connector.tenantId });
+    if (!state || state.version !== dto.version || state.enabled !== dto.enabled || (state.expiresAt ?? null) !== (dto.expiresAt ?? null))
+      throw new ConflictException('ACCESS_STATE_SUPERSEDED');
+    const updated = await this.c('access').updateOne({ _id: state._id, version: dto.version }, { $set: { confirmedVersion: dto.version } });
+    if (!updated.matchedCount) throw new ConflictException('ACCESS_STATE_SUPERSEDED');
+    return { confirmedVersion: dto.version };
+  }
+  async updateDevice(gym: any, actor: string, deviceId: string, dto: DeviceDto) {
+    const device = await this.adminDevice(gym, deviceId);
+    const target = await this.c('connectors').findOne({ _id: oid(dto.connectorId), gymId: gym._id, tenantId: gym.tenantId, revokedAt: null });
+    if (!target) throw new NotFoundException();
+    if (String(device.connectorId) !== dto.connectorId) {
+      const old = await this.c('connectors').findOne({ _id: device.connectorId });
+      if (old && !old.revokedAt) throw new ConflictException('REVOKE_PREVIOUS_CONNECTOR_FIRST');
+    }
+    try { new Intl.DateTimeFormat('en', { timeZone: dto.timezone }).format(); } catch { throw new BadRequestException('INVALID_TIMEZONE'); }
+    if (dto.ip !== '127.0.0.1') throw new BadRequestException('SIMULATOR_LOOPBACK_ONLY');
+    if (device.timezone !== dto.timezone || device.historySince !== dto.historySince || device.adapter !== dto.adapter)
+      throw new ConflictException('HISTORY_AND_ADAPTER_IMMUTABLE');
+    await this.tx(async session => {
+      await this.c('devices').updateOne({ _id: device._id }, { $set: { connectorId: target._id, ip: dto.ip, port: dto.port,
+        report: { reachable: false } } }, { session });
+      await this.c('commands').updateMany({ deviceId: device._id, status: { $in: activeStatuses } },
+        { $set: { status: 'superseded', completedAt: new Date() } }, { session });
+      await this.audit(gym, actor, 'DEVICE_CONFIGURED', device._id, session);
+    });
+    return { deviceId };
+  }
+  async status(gym: any) {
+    const connectors = await this.c('connectors').find({ gymId: gym._id, tenantId: gym.tenantId },
+      { projection: { credentialVerifier: 0, previousVerifier: 0 } }).sort({ createdAt: -1 }).limit(32).toArray();
+    const grace = Math.max(90, Math.min(900, Number(this.config.get('BIOMETRIC_OFFLINE_SECONDS')) || 180));
+    for (const connector of connectors) connector.online = !connector.revokedAt && !!connector.lastHeartbeat && Date.now() - connector.lastHeartbeat.getTime() < grace * 1000;
+    const devices = await this.c('devices').find({ gymId: gym._id, tenantId: gym.tenantId }).limit(16).toArray();
+    const commands = await this.c('commands').find({ gymId: gym._id, tenantId: gym.tenantId }, { projection: { leaseToken: 0 } }).sort({ createdAt: -1 }).limit(50).toArray();
+    const unresolved = await this.c('events').aggregate([{ $match: { gymId: gym._id, memberId: { $exists: false } } },
+      { $group: { _id: { deviceId: '$deviceId', deviceUserId: '$deviceUserId' }, count: { $sum: 1 } } }, { $limit: 100 }]).toArray();
+    const checkpoints = await this.c('checkpoints').find({ gymId: gym._id }).limit(100).toArray();
+    const pendingAccess = await this.c('access').countDocuments({ gymId: gym._id, $expr: { $ne: ['$version', { $ifNull: ['$confirmedVersion', 0] }] } });
+    const installerUrl = this.config.get<string>('BIOMETRIC_INSTALLER_URL');
+    const installerSha256 = this.config.get<string>('BIOMETRIC_INSTALLER_SHA256');
+    let download: any = null;
+    if (installerUrl && /^https:\/\//.test(installerUrl) && /^[a-f0-9]{64}$/.test(installerSha256 ?? '')) download = { url: installerUrl, sha256: installerSha256 };
+    const accessStates = await this.c('access').find({ gymId: gym._id, tenantId: gym.tenantId }).limit(200).toArray();
+    return { connectors, devices, commands, unresolved, checkpoints, pendingAccess, accessStates, download, offlineAfterSeconds: grace };
+  }
+  async revoke(gym: any, actor: any, id: string) {
+    if (!['gym_owner', 'super_admin'].includes(actor.role)) throw new ForbiddenException();
+    await this.tx(async session => {
+      const found = await this.c('connectors').updateOne({ _id: oid(id), gymId: gym._id, tenantId: gym.tenantId },
+        { $set: { revokedAt: new Date() }, $unset: { credentialVerifier: '', previousVerifier: '' } }, { session });
+      if (!found.matchedCount) throw new NotFoundException();
+      await this.c('commands').updateMany({ connectorId: oid(id), status: { $in: activeStatuses } }, { $set: { status: 'expired', completedAt: new Date() } }, { session });
+      await this.audit(gym, actor.userId, 'CONNECTOR_REVOKED', oid(id), session);
+    });
+    return { revoked: true };
+  }
+  async support(gym: any, actor: string, consent: boolean) {
+    if (consent !== true) throw new BadRequestException('EXPLICIT_CONSENT_REQUIRED');
+    const status = await this.status(gym);
+    // Allowlist diagnostic counters only; no free text, credentials, IPs or member data.
+    const diagnostics = { connectors: status.connectors.map(c => ({ id: c._id, online: c.online, version: c.appVersion,
+      lastHeartbeat: c.lastHeartbeat, errorCode: c.health?.errorCode })), deviceCount: status.devices.length,
+      pendingAccess: status.pendingAccess, unresolvedUsers: status.unresolved.length };
+    const result = await this.c('support').insertOne({ gymId: gym._id, tenantId: gym.tenantId, createdBy: oid(actor),
+      diagnostics, status: 'open', createdAt: new Date() });
+    await this.audit(gym, actor, 'SUPPORT_REQUESTED', result.insertedId);
+    return { requestId: String(result.insertedId) };
+  }
+}
