@@ -0,0 +1,50 @@
+import 'reflect-metadata';
+import { test } from 'node:test';
+import * as assert from 'node:assert/strict';
+import { Global, Module } from '@nestjs/common';
+import { MODULE_METADATA } from '@nestjs/common/constants';
+import { ConfigService } from '@nestjs/config';
+import { NestFactory } from '@nestjs/core';
+import { getConnectionToken } from '@nestjs/mongoose';
+import { AuthModule } from '../auth/auth.module';
+import { PermissionsGuard } from '../auth/guards/permissions.guard';
+import { PlanEntitlementsService } from '../subscriptions/plan-entitlements.service';
+import { BiometricModule } from './biometric.module';
+import { BiometricAdminController } from './biometric.controller';
+
+test('biometric admin controller and PermissionsGuard resolve in the feature module', async () => {
+  // Exercise actual model registrations, controllers and guards without starting MongoDB
+  // or the unrelated login infrastructure brought in by AuthModule.
+  const connection = { models: {}, model: () => ({}) };
+  const dependencies = [
+    { provide: getConnectionToken(), useValue: connection },
+    { provide: ConfigService, useValue: {} },
+    { provide: PlanEntitlementsService, useValue: {} },
+  ];
+  @Global()
+  @Module({ providers: dependencies, exports: dependencies.map(({ provide }) => provide) })
+  class TestDependencies {}
+
+  @Module({
+    imports: Reflect.getMetadata(MODULE_METADATA.IMPORTS, BiometricModule)
+      .filter((imported: unknown) => imported !== AuthModule),
+    controllers: Reflect.getMetadata(MODULE_METADATA.CONTROLLERS, BiometricModule),
+    providers: Reflect.getMetadata(MODULE_METADATA.PROVIDERS, BiometricModule),
+  })
+  class IsolatedBiometricModule {}
+
+  @Module({ imports: [TestDependencies, IsolatedBiometricModule] })
+  class TestApp {}
+
+  const app = await NestFactory.createApplicationContext(TestApp, {
+    logger: false,
+    abortOnError: false,
+  });
+  try {
+    const feature = app.select(IsolatedBiometricModule);
+    assert.ok(feature.get(BiometricAdminController, { strict: true }));
+    assert.ok(feature.get(PermissionsGuard, { strict: true }));
+  } finally {
+    await app.close();
+  }
+});
diff --git a/src/biometric/biometric.module.ts b/src/biometric/biometric.module.ts
