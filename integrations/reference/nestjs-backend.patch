@@ -0,0 +1,26 @@
+import { Module } from '@nestjs/common';
+import { MongooseModule } from '@nestjs/mongoose';
+import { AuthModule } from '../auth/auth.module';
+import { User, UserSchema } from '../users/schemas/user.schema';
+import { Role, RoleSchema } from '../roles/schemas/role.schema';
+import { Permission, PermissionSchema } from '../permissions/schemas/permission.schema';
+import { biometricSchemas } from './biometric.schemas';
+import { BiometricService } from './biometric.service';
+import { ConnectorGuard } from './connector.guard';
+import { BiometricAdminController, ConnectorController, ConnectorRegistrationController } from './biometric.controller';
+
+@Module({
+  imports: [
+    AuthModule,
+    MongooseModule.forFeature([
+      ...Object.entries(biometricSchemas).map(([name, schema]) => ({ name, schema })),
+      // Nest instantiates the admin controller's PermissionsGuard in this module.
+      { name: User.name, schema: UserSchema },
+      { name: Role.name, schema: RoleSchema },
+      { name: Permission.name, schema: PermissionSchema },
+    ]),
+  ],
+  controllers: [BiometricAdminController, ConnectorController, ConnectorRegistrationController],
+  providers: [BiometricService, ConnectorGuard],
+})
+export class BiometricModule {}
diff --git a/src/biometric/biometric.schemas.ts b/src/biometric/biometric.schemas.ts
new file mode 100644
index 0000000..e00343c
--- /dev/null
+++ b/src/biometric/biometric.schemas.ts
@@ -0,0 +1,39 @@
+import { Schema } from 'mongoose';
+
+// Registered models make the existing additive seed:indexes migration build
+// every uniqueness constraint. Transactions require a replica set.
+const O = Schema.Types.ObjectId;
+const mixed = Schema.Types.Mixed;
+const schema = (fields: any, collection: string) => new Schema(fields, { collection, timestamps: true });
+export const biometricSchemas = {
+  BiometricPairing: schema({ verifier: String, tenantId: O, gymId: O, createdBy: O, expiresAt: Date, consumedAt: Date, revokedAt: Date }, 'biometricpairings'),
+  BiometricConnector: schema({ tenantId: O, gymId: O, credentialVerifier: String, credentialVersion: Number,
+    previousVerifier: String, previousUntil: Date, revokedAt: Date, appVersion: String, lastHeartbeat: Date, health: mixed }, 'biometricconnectors'),
+  BiometricDevice: schema({ tenantId: O, gymId: O, connectorId: O, adapter: String, ip: String, port: Number,
+    timezone: String, historySince: String, identity: String, capabilities: mixed, report: mixed, generation: String }, 'biometricdevices'),
+  BiometricMapping: schema({ tenantId: O, gymId: O, deviceId: O, deviceUserId: String, memberId: O }, 'biometricmappings'),
+  BiometricAccess: schema({ tenantId: O, gymId: O, deviceId: O, memberId: O, deviceUserId: String,
+    enabled: Boolean, expiresAt: String, version: Number, confirmedVersion: Number }, 'biometricaccess'),
+  BiometricCommand: schema({ tenantId: O, gymId: O, connectorId: O, deviceId: O, type: String, payload: mixed,
+    status: String, attempts: Number, leaseToken: String, leaseUntil: Date, expiresAt: Date, nextAttempt: Date,
+    result: mixed, completedAt: Date, createdBy: O }, 'biometriccommands'),
+  BiometricEvent: schema({ tenantId: O, gymId: O, deviceId: O, eventId: String, generation: String, nativeId: String,
+    deviceUserId: String, memberId: O, occurredAt: Date, rawTimestamp: String, timezone: String, eventType: String,
+    resolvedAt: Date }, 'biometricevents'),
+  BiometricCheckpoint: schema({ tenantId: O, gymId: O, deviceId: O, generation: String, position: String,
+    acknowledgedAt: Date, dataGap: Boolean }, 'biometriccheckpoints'),
+  BiometricSupport: schema({ tenantId: O, gymId: O, createdBy: O, diagnostics: mixed, status: String }, 'biometricsupport'),
+  BiometricAudit: schema({ tenantId: O, gymId: O, actorId: O, action: String, targetId: O }, 'biometricaudits'),
+};
+biometricSchemas.BiometricPairing.index({ verifier: 1 }, { unique: true });
+biometricSchemas.BiometricPairing.index({ expiresAt: 1 }, { expireAfterSeconds: 86400 });
+biometricSchemas.BiometricConnector.index({ gymId: 1, revokedAt: 1 });
+biometricSchemas.BiometricDevice.index({ gymId: 1, identity: 1 }, { unique: true, partialFilterExpression: { identity: { $type: 'string' } } });
+biometricSchemas.BiometricMapping.index({ deviceId: 1, deviceUserId: 1 }, { unique: true });
+biometricSchemas.BiometricMapping.index({ deviceId: 1, memberId: 1 }, { unique: true });
+biometricSchemas.BiometricAccess.index({ deviceId: 1, memberId: 1 }, { unique: true });
+biometricSchemas.BiometricCommand.index({ connectorId: 1, status: 1, nextAttempt: 1, leaseUntil: 1 });
+biometricSchemas.BiometricEvent.index({ gymId: 1, deviceId: 1, eventId: 1 }, { unique: true });
