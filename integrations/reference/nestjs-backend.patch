+import { CanActivate, ExecutionContext, Injectable } from '@nestjs/common';
+import { BiometricService } from './biometric.service';
+
+// These routes bypass the HUMAN JWT guard only; this guard authenticates every
+// connector request and checks revocation + active tenant/gym in the database.
+@Injectable()
+export class ConnectorGuard implements CanActivate {
+  constructor(private readonly service: BiometricService) {}
+  async canActivate(context: ExecutionContext) {
+    const req = context.switchToHttp().getRequest();
+    req.connector = await this.service.authenticate(req.headers.authorization);
+    return true;
+  }
+}
