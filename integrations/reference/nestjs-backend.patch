+  assert.equal((await http('POST', '/connectors/me/heartbeat', payload)).status, 401);
+  assert.equal((await http('POST', '/connectors/me/heartbeat', { ...payload, gymId: String(gymB) }, installed.token)).status, 400);
+  assert.equal((await http('POST', '/connectors/me/heartbeat', payload, installed.token)).status, 201);
+  const other = await installation();
+  assert.equal((await http('PUT', '/connectors/me/devices/' + new Types.ObjectId() + '/report',
+    { reachable: false, attendance: false, access: false, expiry: false }, other.token)).status, 404);
+  const rotated = await service.rotate(installed.connector);
+  await service.token(installed.pair); // old secret works only during recovery grace
+  await service.token(rotated);
+  await collection('biometricconnectors').updateOne({ _id: installed.connector._id }, { $set: { previousUntil: new Date(0) } });
+  await assert.rejects(service.token(installed.pair));
+  const pendingPoll = http('GET', '/connectors/me/commands?waitSeconds=5', undefined, installed.token);
+  await new Promise(resolve => setTimeout(resolve, 100));
+  await service.revoke(gym(), { role: 'gym_owner', userId: String(actor) }, installed.pair.connectorId);
+  assert.equal((await http('POST', '/connectors/me/heartbeat', payload, installed.token)).status, 401);
+  assert.equal((await pendingPoll).status, 401);
+  await assert.rejects(service.token(rotated));
+  const old = await installation();
+  await collection('biometricconnectors').updateOne({ _id: old.connector._id }, { $set: { lastHeartbeat: new Date(Date.now() - 181000) } });
+  assert.equal((await service.status(gym())).connectors.find(c => String(c._id) === String(old.connector._id)).online, false);
+  const status = JSON.stringify(await service.status(gym()));
+  assert.ok(!status.includes('credentialVerifier') && !status.includes(rotated.credential));
+  await assert.rejects(service.support(gym(), String(actor), false));
+});
