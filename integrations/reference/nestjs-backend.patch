diff --git a/src/biometric/biometric.controller.ts b/src/biometric/biometric.controller.ts
new file mode 100644
index 0000000..4b675cc
--- /dev/null
+++ b/src/biometric/biometric.controller.ts
@@ -0,0 +1,66 @@
+import { Body, Controller, Get, Param, Post, Put, Query, Request, UseGuards } from '@nestjs/common';
+import { Throttle } from '@nestjs/throttler';
+import { Public } from '../auth/decorators/public.decorator';
+import { Permissions } from '../auth/decorators/permissions.decorator';
+import { PermissionsGuard } from '../auth/guards/permissions.guard';
+import { AccessDto, AckDto, BatchDto, DeviceDto, HeartbeatDto, MappingDto, ObservedAccessDto, PairDto, ReportDto, ResultDto, SupportDto, TokenDto } from './biometric.dto';
+import { BiometricService } from './biometric.service';
+import { ConnectorGuard } from './connector.guard';
+
+@Controller('connectors')
+export class ConnectorRegistrationController {
+  constructor(private readonly service: BiometricService) {}
+  @Post('pair') @Public() @Throttle({ default: { limit: 5, ttl: 60000 } })
+  pair(@Body() dto: PairDto) { return this.service.pair(dto); }
+  @Post('token') @Public() @Throttle({ default: { limit: 30, ttl: 60000 } })
+  token(@Body() dto: TokenDto) { return this.service.token(dto); }
+}
+
+@Public() @UseGuards(ConnectorGuard)
+@Controller('connectors/me')
+export class ConnectorController {
+  constructor(private readonly service: BiometricService) {}
+  @Post('rotate-credential') rotate(@Request() req) { return this.service.rotate(req.connector); }
+  @Post('heartbeat') heartbeat(@Request() req, @Body() dto: HeartbeatDto) { return this.service.heartbeat(req.connector, dto); }
+  @Get('devices') devices(@Request() req) { return this.service.devices(req.connector); }
+  @Put('devices/:deviceId/report') report(@Request() req, @Param('deviceId') id: string, @Body() dto: ReportDto) { return this.service.report(req.connector, id, dto); }
+  @Get('devices/:deviceId/access-state') access(@Request() req, @Param('deviceId') id: string, @Query('after') after?: string) { return this.service.access(req.connector, id, after); }
+  @Post('devices/:deviceId/access-observed') observed(@Request() req, @Param('deviceId') id: string, @Body() dto: ObservedAccessDto) { return this.service.observed(req.connector, id, dto); }
+  @Get('commands') commands(@Request() req, @Query('waitSeconds') wait?: string) {
+    const seconds = Math.max(0, Math.min(15, Number(wait) || 0));
+    return this.service.commands(req.connector, seconds);
+  }
+  @Post('commands/:commandId/ack') ack(@Request() req, @Param('commandId') id: string, @Body() dto: AckDto) { return this.service.ack(req.connector, id, dto.leaseToken); }
+  @Post('commands/:commandId/result') result(@Request() req, @Param('commandId') id: string, @Body() dto: ResultDto) { return this.service.result(req.connector, id, dto); }
+  @Post('attendance/batches') @Throttle({ default: { limit: 60, ttl: 60000 } })
+  ingest(@Request() req, @Body() dto: BatchDto) { return this.service.ingest(req.connector, dto); }
+}
+
+@UseGuards(PermissionsGuard)
+@Controller('gyms/:gymId/biometric')
+export class BiometricAdminController {
+  constructor(private readonly service: BiometricService) {}
+  private gym(req: any, id: string) { return this.service.gym(req.user, id); }
+  @Get('status') @Permissions('attendance.read')
+  async status(@Request() req, @Param('gymId') gym: string) { return { success: true, data: await this.service.status(await this.gym(req, gym)) }; }
+  @Post('pairing-codes') @Permissions('attendance.update') @Throttle({ default: { limit: 5, ttl: 60000 } })
+  async pair(@Request() req, @Param('gymId') gym: string) { return { success: true, data: await this.service.issuePairing(await this.gym(req, gym), req.user.userId) }; }
+  @Post('devices') @Permissions('attendance.update')
+  async add(@Request() req, @Param('gymId') gym: string, @Body() dto: DeviceDto) { return { success: true, data: await this.service.addDevice(await this.gym(req, gym), req.user.userId, dto) }; }
+  @Put('devices/:deviceId') @Permissions('attendance.update')
+  async update(@Request() req, @Param('gymId') gym: string, @Param('deviceId') id: string, @Body() dto: DeviceDto) { return { success: true, data: await this.service.updateDevice(await this.gym(req, gym), req.user.userId, id, dto) }; }
+  @Post('connectors/:connectorId/discover') @Permissions('attendance.update') @Throttle({ default: { limit: 5, ttl: 60000 } })
+  async discover(@Request() req, @Param('gymId') gym: string, @Param('connectorId') id: string) { return { success: true, data: await this.service.discover(await this.gym(req, gym), req.user.userId, id) }; }
+  @Post('devices/:deviceId/sync') @Permissions('attendance.update') @Throttle({ default: { limit: 10, ttl: 60000 } })
+  async sync(@Request() req, @Param('gymId') gym: string, @Param('deviceId') id: string) { return { success: true, data: await this.service.queue(await this.gym(req, gym), req.user.userId, id, 'SYNC_ATTENDANCE') }; }
+  @Post('devices/:deviceId/test') @Permissions('attendance.update') @Throttle({ default: { limit: 10, ttl: 60000 } })
+  async test(@Request() req, @Param('gymId') gym: string, @Param('deviceId') id: string) { return { success: true, data: await this.service.queue(await this.gym(req, gym), req.user.userId, id, 'TEST_DEVICE_CONNECTION') }; }
+  @Put('devices/:deviceId/mappings') @Permissions('attendance.update', 'members.update')
+  async map(@Request() req, @Param('gymId') gym: string, @Param('deviceId') id: string, @Body() dto: MappingDto) { return { success: true, data: await this.service.map(await this.gym(req, gym), req.user.userId, id, dto) }; }
+  @Put('devices/:deviceId/members/:memberId/access') @Permissions('attendance.update', 'members.update')
+  async access(@Request() req, @Param('gymId') gym: string, @Param('deviceId') id: string, @Param('memberId') member: string, @Body() dto: AccessDto) { return { success: true, data: await this.service.setAccess(await this.gym(req, gym), req.user.userId, id, member, dto) }; }
+  @Post('connectors/:connectorId/revoke') @Permissions('attendance.update')
+  async revoke(@Request() req, @Param('gymId') gym: string, @Param('connectorId') id: string) { return { success: true, data: await this.service.revoke(await this.gym(req, gym), req.user, id) }; }
+  @Post('support-requests') @Permissions('attendance.update') @Throttle({ default: { limit: 3, ttl: 60000 } })
+  async support(@Request() req, @Param('gymId') gym: string, @Body() dto: SupportDto) { return { success: true, data: await this.service.support(await this.gym(req, gym), req.user.userId, dto.consent) }; }
+}
diff --git a/src/biometric/biometric.dto.ts b/src/biometric/biometric.dto.ts
new file mode 100644
index 0000000..44d595c
--- /dev/null
+++ b/src/biometric/biometric.dto.ts
@@ -0,0 +1,90 @@
+import { Type } from 'class-transformer';
+import { ArrayMaxSize, ArrayMinSize, IsArray, IsBoolean, IsDateString, IsIn, IsInt, IsIP, IsMongoId, IsOptional, IsString, Matches, Max, MaxLength, Min, ValidateNested } from 'class-validator';
+
+export class PairDto {
+  @IsString() @Matches(/^[A-F0-9]{12}$/) code: string;
+  @IsString() @MaxLength(40) appVersion: string;
+}
+export class TokenDto {
+  @IsMongoId() connectorId: string;
+  @IsString() @Matches(/^[a-f0-9]{64}$/) credential: string;
+}
+export class DeviceDto {
+  @IsOptional() @IsString() @MaxLength(120) expectedIdentity?: string;
+  @IsMongoId() connectorId: string;
+  // Only the simulator has a tested adapter in this release.
+  @IsIn(['simulator']) adapter: string;
+  @IsIP(4) ip: string;
+  @IsInt() @Min(1) @Max(65535) port: number;
+  @IsString() @MaxLength(80) timezone: string;
+  @IsDateString() historySince: string;
+}
+export class HeartbeatDto {
+  @IsString() @MaxLength(40) appVersion: string;
+  @IsInt() @Min(0) @Max(100000) pendingCount: number;
+  @IsOptional() @IsIn(['idle', 'sync', 'command']) operation?: string;
+  @IsOptional() @IsDateString() lastDeviceCommunication?: string;
+  @IsOptional() @IsDateString() lastAttendanceFetch?: string;
+  @IsOptional() @IsDateString() lastAcknowledgedUpload?: string;
+  @IsOptional() @IsIn(['CLOUD_DNS', 'CLOUD_TLS', 'CLOUD_AUTH', 'CLOUD_SERVER', 'CLOUD_NETWORK', 'DEVICE_UNREACHABLE', 'DATA_GAP', 'QUEUE_FULL', 'STORAGE_ERROR', 'IDENTITY_MISMATCH', 'UNSUPPORTED', 'INVALID_DEVICE_DATA', 'INTERNAL_ERROR']) errorCode?: string;
+}
+export class ReportDto {
+  @IsOptional() @IsIP(4) ip?: string;
+  @IsOptional() @IsInt() @Min(1) @Max(65535) port?: number;
+  @IsBoolean() reachable: boolean;
+  @IsOptional() @IsString() @MaxLength(120) identity?: string;
+  @IsBoolean() attendance: boolean;
+  @IsBoolean() access: boolean;
+  @IsBoolean() expiry: boolean;
+  @IsOptional() @IsIn(['DEVICE_UNREACHABLE', 'DATA_GAP', 'IDENTITY_MISMATCH', 'UNSUPPORTED', 'INVALID_DEVICE_DATA']) errorCode?: string;
+}
+export class AckDto {
+  @IsString() @Matches(/^[a-f0-9]{32}$/) leaseToken: string;
+}
+export class ResultDto extends AckDto {
+  @IsIn(['succeeded', 'failed', 'superseded']) status: string;
+  @IsOptional() @IsIn(['DEVICE_UNREACHABLE', 'DATA_GAP', 'QUEUE_FULL', 'STORAGE_ERROR', 'IDENTITY_MISMATCH', 'UNSUPPORTED', 'INVALID_DEVICE_DATA', 'INTERNAL_ERROR']) errorCode?: string;
+  @IsOptional() @IsInt() @Min(0) count?: number;
+  @IsOptional() @IsBoolean() transient?: boolean;
+  @IsOptional() @IsArray() @ArrayMaxSize(32) @ValidateNested({ each: true }) @Type(() => DiscoveryCandidateDto) candidates?: DiscoveryCandidateDto[];
+}
+export class DiscoveryCandidateDto {
+  @IsString() @MaxLength(120) identity: string;
+  @IsIn(['simulator']) adapter: string;
+  @IsIP(4) ip: string;
+  @IsInt() @Min(1) @Max(65535) port: number;
+}
+export class EventDto {
+  @IsString() @Matches(/^[a-f0-9]{64}$/) eventId: string;
+  @IsString() @MaxLength(100) nativeId: string;
+  @IsString() @MaxLength(100) deviceUserId: string;
+  @IsDateString() occurredAt: string;
+  @IsString() @MaxLength(100) rawTimestamp: string;
+  @IsString() @MaxLength(80) timezone: string;
+  @IsIn(['check-in', 'check-out', 'access-granted', 'access-denied', 'unknown']) eventType: string;
+}
+export class BatchDto {
+  @IsMongoId() deviceId: string;
+  @IsString() @MaxLength(100) generation: string;
+  @IsString() @Matches(/^\d{1,16}$/) position: string;
+  @IsBoolean() dataGap: boolean;
+  @IsArray() @ArrayMaxSize(200) @ValidateNested({ each: true }) @Type(() => EventDto) events: EventDto[];
+}
+export class MappingDto {
+  @IsString() @MaxLength(100) deviceUserId: string;
+  @IsMongoId() memberId: string;
+}
+export class AccessDto {
+  @IsBoolean() enabled: boolean;
+  @IsOptional() @IsDateString() expiresAt?: string;
+}
+export class SupportDto {
+  @IsBoolean() consent: boolean;
+}
+
+export class ObservedAccessDto {
+  @IsMongoId() memberId: string;
+  @IsInt() @Min(1) version: number;
+  @IsBoolean() enabled: boolean;
+  @IsOptional() @IsDateString() expiresAt?: string;
+}
