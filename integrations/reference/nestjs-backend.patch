@@ -0,0 +1,7 @@
+import { Types } from 'mongoose';
+
+/** Biometric attendance is owned by its source gym, even for multi-gym users. */
+export function biometricAttendanceFilter(gymIds?: Types.ObjectId[], tenantId?: Types.ObjectId): any {
+  if (!gymIds && !tenantId) return {};
+  return { $or: [{ biometricEventKey: { $exists: false } }, gymIds ? { gymId: { $in: gymIds } } : { tenantId }] };
+}
