+:host { display: block; }
+.biometric-page { max-width: 1320px; margin: 0 auto; }
+.page-heading, .connector-row, .device-row { display: flex; justify-content: space-between; gap: 1.5rem; align-items: flex-start; }
+.page-heading { margin-bottom: 1.5rem; }
+h1 { font-size: 1.75rem; } h2 { font-size: 1.2rem; margin-bottom: 1rem; } h3 { font-size: 1rem; }
+.gym-picker { min-width: 220px; }
+.setup-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; padding-left: 1.5rem; }
+.setup-steps li { padding-left: .5rem; }
+.configuration-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
+label { display: block; font-weight: 500; } label .form-control, label .form-select { margin-top: .35rem; }
