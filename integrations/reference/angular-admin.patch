@@ -0,0 +1,10 @@
+import { inject } from '@angular/core';
+import { CanActivateFn, Router } from '@angular/router';
+import { AuthService } from '../services/auth.service';
+
+// Attendance.read is also granted to members/trainers for their own history.
+// The biometric management screen is a staff resource; API enforces this too.
+export const biometricRoleGuard: CanActivateFn = () => {
+  const role = inject(AuthService).getUser()?.role?.name?.toLowerCase();
+  return role && !['member', 'trainer'].includes(role) ? true : inject(Router).createUrlTree(['/notification-center']);
+};
