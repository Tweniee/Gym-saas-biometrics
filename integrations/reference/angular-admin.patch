+import { CommonModule } from '@angular/common';
+import { Component, computed, DestroyRef, inject, OnInit, signal } from '@angular/core';
+import { FormsModule } from '@angular/forms';
+import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
+import { catchError, EMPTY, exhaustMap, finalize, Subject, switchMap, timer } from 'rxjs';
+import { BiometricConnector, BiometricDevice, BiometricService, BiometricStatus, DiscoveryCandidate } from '../../services/biometric.service';
+import { Gym, GymsService } from '../../services/gyms.service';
+import { Member, MembersService } from '../../services/members.service';
+import { PermissionsService } from '../../services/permissions.service';
+
+@Component({
+  selector: 'app-biometric', standalone: true, imports: [CommonModule, FormsModule],
+  templateUrl: './biometric.component.html', styleUrl: './biometric.component.scss',
+})
+export class BiometricComponent implements OnInit {
+  private readonly api = inject(BiometricService);
+  private readonly gymsApi = inject(GymsService);
+  private readonly membersApi = inject(MembersService);
+  private readonly destroy = inject(DestroyRef);
+  readonly permissions = inject(PermissionsService);
+  readonly gyms = signal<Gym[]>([]);
+  readonly state = signal<BiometricStatus | null>(null);
+  readonly error = signal('');
+  readonly message = signal('');
+  readonly busy = signal(false);
+  readonly loading = signal(false);
+  readonly pairing = signal<{ code: string; expiresAt: string } | null>(null);
+  readonly now = signal(Date.now());
+  readonly members = signal<Member[]>([]);
+  readonly gymChanges = new Subject<string>();
+  gymId = '';
+  connectorId = '';
+  deviceId = '';
+  editingDeviceId = '';
+  expectedIdentity = '';
+  ip = '127.0.0.1';
+  port = 4370;
+  timezone = 'Asia/Kolkata';
+  historySince = new Date(Date.now() - 86400000).toISOString();
+  deviceUserId = '';
+  memberId = '';
+  memberSearch = '';
+  accessExpiry = '';
+  supportConsent = false;
+  readonly canManage = computed(() => this.permissions.hasPermission('attendance', 'update'));
+  readonly canMap = computed(() => this.canManage() && this.permissions.hasPermission('members', 'update'));
+  readonly canRevoke = computed(() => this.permissions.isGymOwner() || this.permissions.isSuperAdmin());
+  readonly activePairing = computed(() => { const p = this.pairing(); return p && new Date(p.expiresAt).getTime() > this.now() ? p : null; });
+  readonly selectedDevice = computed(() => this.state()?.devices.find(d => d._id === this.selectedDeviceId()) ?? null);
+  readonly selectedDeviceId = signal('');
+  readonly candidates = computed(() => this.state()?.commands.filter(c => c.type === 'DISCOVER_DEVICES' && c.status === 'succeeded')
+    .flatMap(c => (c.result?.candidates ?? []).map(candidate => ({ ...candidate, connectorId: c.connectorId }))) ?? []);
+
+  ngOnInit() {
+    this.gymsApi.getAllGyms(1, 100).pipe(takeUntilDestroyed(this.destroy)).subscribe({
+      next: r => { this.gyms.set(r.data.filter(g => g.isActive)); if (this.gyms().length === 1) { this.gymId = this.gyms()[0]._id; this.selectGym(); } },
+      error: () => this.error.set('Could not load gyms.'),
+    });
+    this.gymChanges.pipe(switchMap(gym => gym ? timer(0, 5000).pipe(exhaustMap(() => this.api.status(gym).pipe(
+      catchError(() => { this.state.set(null); this.loading.set(false); this.error.set('Status unavailable. Check your connection and permissions.'); return EMPTY; }),
+    ))) : EMPTY), takeUntilDestroyed(this.destroy)).subscribe(status => { this.state.set(status); this.loading.set(false); if (this.error().startsWith('Status unavailable')) this.error.set(''); });
+    timer(0, 1000).pipe(takeUntilDestroyed(this.destroy)).subscribe(() => this.now.set(Date.now()));
+  }
+  selectGym() {
+    this.state.set(null); this.pairing.set(null); this.connectorId = ''; this.deviceId = ''; this.selectedDeviceId.set('');
+    this.editingDeviceId = ''; this.expectedIdentity = ''; this.memberId = '';  this.members.set([]); this.error.set(''); this.message.set(''); this.supportConsent = false;
+    this.loading.set(!!this.gymId); this.gymChanges.next(this.gymId);
+  }
+  private action<T>(method: 'POST' | 'PUT', route: string, body: unknown, done: (result: T) => void) {
+    if (!this.gymId || this.busy()) return;
+    this.error.set(''); this.message.set(''); this.busy.set(true);
+    this.api.action<T>(this.gymId, method, route, body).pipe(finalize(() => this.busy.set(false)), takeUntilDestroyed(this.destroy)).subscribe({
+      next: result => { done(result); this.gymChanges.next(this.gymId); },
+      error: e => this.error.set(typeof e.error?.message === 'string' ? e.error.message : 'Action failed. Check configuration and permissions.'),
+    });
+  }
+  pair() { this.action<{ code: string; expiresAt: string }>('POST', '/pairing-codes', {}, code => this.pairing.set(code)); }
+  discover() { if (this.connectorId) this.queue('/connectors/' + this.connectorId + '/discover'); }
+  queue(route: string) { this.action<{ commandId: string }>('POST', route, {}, r => this.message.set('Queued command ' + r.commandId + '. Device success appears in command results.')); }
+  selectCandidate(candidate: DiscoveryCandidate & { connectorId: string }) {
+    this.connectorId = candidate.connectorId; this.ip = candidate.ip; this.port = candidate.port;
+    this.editingDeviceId = ''; this.expectedIdentity = candidate.identity; this.message.set('Selected ' + candidate.identity + '. Confirm the assignment below.');
+  }
+  saveDevice() {
+    const date = new Date(this.historySince);
+    if (!Number.isFinite(date.getTime()) || !this.connectorId) { this.error.set('Select a connector and a valid history start.'); return; }
+    this.action('POST', '/devices', { connectorId: this.connectorId, adapter: 'simulator', ip: this.ip, port: this.port,
+      timezone: this.timezone, historySince: date.toISOString(), ...(this.expectedIdentity ? { expectedIdentity: this.expectedIdentity } : {}) }, () => this.message.set('Device assigned. Test its connection, then run the initial sync.'));
+  }
+  editDevice(device: BiometricDevice) {
+    this.expectedIdentity = ''; this.editingDeviceId = device._id; this.connectorId = device.connectorId; this.ip = device.ip; this.port = device.port;
+    this.timezone = device.timezone; this.historySince = device.historySince;
+  }
+  updateDevice() {
+    this.action('PUT', '/devices/' + this.editingDeviceId, { connectorId: this.connectorId, adapter: 'simulator', ip: this.ip,
+      port: this.port, timezone: this.timezone, historySince: this.historySince }, () => { this.editingDeviceId = ''; this.message.set('Device configuration updated. Test the connection again.'); });
+  }
+  selectDevice() { this.selectedDeviceId.set(this.deviceId); }
+  searchMembers() {
+    if (!this.gymId || !this.permissions.hasPermission('members', 'read')) return;
+    this.membersApi.searchMembers(this.memberSearch, 1, 25, this.gymId).pipe(takeUntilDestroyed(this.destroy)).subscribe({
+      next: r => this.members.set(r.data), error: () => this.error.set('Could not load members.'),
+    });
+  }
+  map() {
+    if (!this.deviceId || !this.memberId || !this.deviceUserId.trim()) return;
+    this.action<{ more: boolean }>('PUT', '/devices/' + this.deviceId + '/mappings', { memberId: this.memberId, deviceUserId: this.deviceUserId.trim() },
+      result => this.message.set(result.more ? 'Mapping saved. Repeat to resolve the next page of historical events.' : 'Member mapped and unresolved attendance reconciled.'));
+  }
+  setAccess(enabled: boolean) {
+    if (!this.deviceId || !this.memberId) return;
+    const body: { enabled: boolean; expiresAt?: string } = { enabled };
+    if (this.accessExpiry) {
+      const date = new Date(this.accessExpiry);
+      if (!Number.isFinite(date.getTime())) { this.error.set('Enter a valid access expiry.'); return; }
+      body.expiresAt = date.toISOString();
+    }
+    this.action<{ commandId: string }>('PUT', '/devices/' + this.deviceId + '/members/' + this.memberId + '/access', body,
+      result => this.message.set('Desired access saved. Await device confirmation for command ' + result.commandId + '.'));
+  }
+  revoke(connector: BiometricConnector) {
+    if (!confirm('Revoke this connector? Its devices stop syncing until you pair a replacement and reassign them.')) return;
+    this.action('POST', '/connectors/' + connector._id + '/revoke', {}, () => this.message.set('Connector revoked. Generate a fresh pairing code to pair a replacement.'));
+  }
+  support() { this.action<{ requestId: string }>('POST', '/support-requests', { consent: this.supportConsent }, result => { this.supportConsent = false; this.message.set('Support request saved: ' + result.requestId); }); }
+  connectorOnline(device: BiometricDevice) { return !!this.state()?.connectors.find(c => c._id === device.connectorId)?.online; }
+  deviceName(id: string) { const device = this.state()?.devices.find(d => d._id === id); return device?.identity || device?.ip || id; }
+}
