+        @if (candidates().length) { <h3 class="mt-3">Discovered candidates</h3><p>Select the intended device, then confirm its assignment.</p><div class="candidate-list">@for (candidate of candidates(); track $index) { <button type="button" class="btn btn-outline-secondary" [disabled]="busy()" (click)="selectCandidate(candidate)">{{ candidate.identity }} · {{ candidate.ip }}:{{ candidate.port }}</button> }</div> }
