new file mode 100644
index 0000000..219d366
--- /dev/null
+++ b/src/app/services/biometric.service.ts
@@ -0,0 +1,37 @@
+import { inject, Injectable } from '@angular/core';
+import { HttpClient } from '@angular/common/http';
+import { map } from 'rxjs';
+import { environment } from '../../environments/environment';
+
+export interface BiometricConnector {
+  _id: string; online: boolean; revokedAt?: string; appVersion: string; lastHeartbeat?: string;
+  health?: { lastDeviceCommunication?: string; lastAttendanceFetch?: string; lastAcknowledgedUpload?: string; pendingCount: number; operation?: string; errorCode?: string };
+}
+export interface BiometricDevice {
+  _id: string; connectorId: string; adapter: string; identity?: string; ip: string; port: number; timezone: string; historySince: string;
+  capabilities: { attendance: boolean; access: boolean; expiry: boolean };
+  report?: { reachable: boolean; lastCommunication?: string; errorCode?: string };
+}
+export interface DeviceConfiguration { connectorId: string; adapter: string; ip: string; port: number; timezone: string; historySince: string; }
+export interface DiscoveryCandidate { identity: string; adapter: string; ip: string; port: number; }
+export interface BiometricCommand {
+  _id: string; connectorId: string; deviceId?: string; type: string; status: string; createdAt: string;
+  result?: { count?: number; errorCode?: string; candidates?: DiscoveryCandidate[] };
+}
+export interface BiometricStatus {
+  connectors: BiometricConnector[]; devices: BiometricDevice[]; commands: BiometricCommand[];
+  unresolved: { _id: { deviceId: string; deviceUserId: string }; count: number }[];
+  checkpoints: { deviceId: string; acknowledgedAt: string; dataGap: boolean }[];
+  pendingAccess: number; offlineAfterSeconds: number;
+  accessStates: { deviceId: string; memberId: string; enabled: boolean; version: number; confirmedVersion?: number }[];
+  download: { url: string; sha256: string } | null;
+}
+@Injectable({ providedIn: 'root' })
+export class BiometricService {
+  private readonly http = inject(HttpClient);
+  private base(gym: string) { return environment.apiUrl + '/gyms/' + encodeURIComponent(gym) + '/biometric'; }
+  status(gym: string) { return this.http.get<{ data: BiometricStatus }>(this.base(gym) + '/status').pipe(map(r => r.data)); }
+  action<T>(gym: string, method: 'POST' | 'PUT', route: string, body: unknown = {}) {
+    return this.http.request<{ data: T }>(method, this.base(gym) + route, { body }).pipe(map(r => r.data));
+  }
+}
