+import { ComponentFixture, fakeAsync, TestBed, tick, discardPeriodicTasks } from '@angular/core/testing';
+import { of, Subject, throwError } from 'rxjs';
+import { BiometricComponent } from './biometric.component';
+import { BiometricService, BiometricStatus } from '../../services/biometric.service';
+import { GymsService } from '../../services/gyms.service';
+import { MembersService } from '../../services/members.service';
+import { PermissionsService } from '../../services/permissions.service';
+
+const status = (): BiometricStatus => ({ connectors: [{ _id: 'connector', online: true, appVersion: '0.1.0' }],
+  devices: [{ _id: 'device', connectorId: 'connector', adapter: 'simulator', ip: '127.0.0.1', port: 4370,
+    timezone: 'Asia/Kolkata', historySince: '2026-10-18T00:00:00.000Z', capabilities: { attendance: false, access: false, expiry: false }, report: { reachable: false } }],
+  commands: [], unresolved: [], checkpoints: [], pendingAccess: 0, accessStates: [], offlineAfterSeconds: 180, download: null });
+
+describe('BiometricComponent', () => {
+  let fixture: ComponentFixture<BiometricComponent>, component: BiometricComponent;
+  let api: jasmine.SpyObj<BiometricService>;
+  beforeEach(async () => {
+    api = jasmine.createSpyObj('BiometricService', ['status', 'action']);
+    api.status.and.returnValue(of(status()));
+    api.action.and.returnValue(of({ commandId: 'queued' }));
+    await TestBed.configureTestingModule({ imports: [BiometricComponent], providers: [
+      { provide: BiometricService, useValue: api },
+      { provide: GymsService, useValue: { getAllGyms: () => of({ data: [] }) } },
+      { provide: MembersService, useValue: { searchMembers: () => of({ data: [] }) } },
+      { provide: PermissionsService, useValue: { hasPermission: () => true, isGymOwner: () => true, isSuperAdmin: () => false } },
+    ] }).compileComponents();
+    fixture = TestBed.createComponent(BiometricComponent); component = fixture.componentInstance;
+  });
+  afterEach(() => fixture.destroy());
+  function start() { fixture.detectChanges(); component.gymId = 'gym'; component.selectGym(); tick(0); fixture.detectChanges(); }
+
+  it('does not mark a device connected because its connector authenticated', fakeAsync(() => {
+    start();
+    expect(fixture.nativeElement.textContent).toContain('Connected to Zenvore');
+    expect(fixture.nativeElement.textContent).toContain('Unreachable or not tested');
+    const sync = [...fixture.nativeElement.querySelectorAll('button')].find((b: any) => b.textContent.trim() === 'Sync now') as HTMLButtonElement;
+    expect(sync.disabled).toBeTrue();
+    discardPeriodicTasks();
+  }));
+  it('shows a committed zero-event sync independently of device access capability', fakeAsync(() => {
+    const s = status(); s.checkpoints = [{ deviceId: 'device', acknowledgedAt: new Date().toISOString(), dataGap: false }];
+    s.commands = [{ _id: 'command', connectorId: 'connector', type: 'SYNC_ATTENDANCE', status: 'succeeded', createdAt: new Date().toISOString(), result: { count: 0 } }];
+    api.status.and.returnValue(of(s)); start();
+    expect(fixture.nativeElement.textContent).toContain('0 events synced');
+    expect(fixture.nativeElement.textContent).toContain('A fetch with zero scans is successful');
+    const enable = [...fixture.nativeElement.querySelectorAll('button')].find((b: any) => b.textContent.trim() === 'Enable access') as HTMLButtonElement;
+    expect(enable.disabled).toBeTrue(); discardPeriodicTasks();
+  }));
+  it('cancels old-gym polling results and clears pairing information on gym change', fakeAsync(() => {
+    const old = new Subject<BiometricStatus>(); api.status.and.returnValue(old); start();
+    component.pairing.set({ code: 'ABCDEF123456', expiresAt: new Date(Date.now() + 300000).toISOString() });
+    const newer = status(); newer.pendingAccess = 7;
+    api.status.and.returnValue(of(newer)); component.gymId = 'new'; component.selectGym(); tick(0);
+    old.next(status());
+    expect(component.state()?.pendingAccess).toBe(7); expect(component.pairing()).toBeNull(); discardPeriodicTasks();
+  }));
+  it('hides stale health information when status cannot be refreshed', fakeAsync(() => {
+    start(); api.status.and.returnValue(throwError(() => new Error('network'))); tick(5000); fixture.detectChanges();
+    expect(component.state()).toBeNull(); expect(fixture.nativeElement.textContent).toContain('Status unavailable'); discardPeriodicTasks();
+  }));
+  it('requires explicit support consent and never infers device success from command enqueue', fakeAsync(() => {
+    start(); component.queue('/devices/device/sync'); tick(0); fixture.detectChanges();
+    expect(component.message()).toContain('Queued command');
+    const support = [...fixture.nativeElement.querySelectorAll('button')].find((b: any) => b.textContent.trim() === 'Submit support request') as HTMLButtonElement;
+    expect(support.disabled).toBeTrue(); discardPeriodicTasks();
+  }));
+  it('expires pairing codes without saving them to browser storage', fakeAsync(() => {
+    start(); const storage = spyOn(localStorage, 'setItem');
+    api.action.and.returnValue(of({ code: 'ABCDEF123456', expiresAt: new Date(Date.now() + 1000).toISOString() }));
+    component.pair(); expect(component.activePairing()?.code).toBe('ABCDEF123456');
+    tick(2000); expect(component.activePairing()).toBeNull(); expect(storage).not.toHaveBeenCalled(); discardPeriodicTasks();
+  }));
+  it('shows device reachability as unknown when connector goes offline', fakeAsync(() => {
+    const s = status(); s.connectors[0].online = false; s.devices[0].report = { reachable: true };
+    api.status.and.returnValue(of(s)); start();
+    expect(fixture.nativeElement.textContent).toContain('Unknown while connector is offline'); discardPeriodicTasks();
+  }));
+});
