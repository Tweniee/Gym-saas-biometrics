+.pair-code { display: flex; flex-direction: column; gap: .35rem; margin-top: 1rem; }
+.pair-code code { font-size: 1.6rem; letter-spacing: .12em; } .pair-code span { font-size: .85rem; }
+@media (max-width: 850px) { .setup-steps, .configuration-form { grid-template-columns: 1fr; } .page-heading, .device-row, .connector-row { flex-direction: column; } .gym-picker { width: 100%; } }
